# 开发环境配置
# Mock_Mode 与 Proxy_Mode 互斥，同一运行实例中不得混用
# VITE_APP_USE_MOCK=true  → 所有接口走 vite-plugin-mock-dev-server（mock/ 目录），禁用 proxy
# VITE_APP_USE_MOCK=false → 所有接口代理到 VITE_APP_API_URL（Proxy_Mode）
# 两者同时配置时，以 mock 优先并输出警告
VITE_APP_USE_MOCK=false

# 接口请求基础路径（proxy 模式下作为代理前缀）
VITE_APP_BASE_API=/dev-api

# 后端接口地址（VITE_APP_USE_MOCK=false 时生效）
VITE_APP_API_URL=https://api.uoquo.com

# 子应用静态资源基础路径（Vite base，独立开发模式使用根路径）
VITE_APP_PUBLIC_PATH=/

# 子应用挂载到主应用后的宿主路由前缀
VITE_APP_HOST_ROUTE_PREFIX=/platform/
