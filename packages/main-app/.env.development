# 应用端口
VITE_APP_PORT=7100
# 启用 Mock 服务(true:开启 false:关闭)
VITE_MOCK_DEV_SERVER=false

# 项目名称
VITE_APP_TITLE=运营平台

# 接口基础路径（开发环境则为代理前缀）
VITE_APP_BASE_API=/dev-api

# 接口地址（用于node代理, vite.config.ts中server.proxy使用）
# 线上
VITE_APP_API_URL=https://api.uoquo.com
# 本地
# VITE_APP_API_URL=http://localhost:8000

# 多租户开关(true:开启 false:关闭)
VITE_APP_TENANT_ENABLED=false

# 子应用多实例开关(true:多实例，子应用常驻并保留页面缓存 false:单实例，切换子应用时卸载上一个)
# 自测多实例可在 .env.development.local 中设置为 true
VITE_APP_MULTI_INSTANCE=false

# 标签页数量上限（不含固定标签），超出时自动关闭最早打开的标签，默认 15
# VITE_APP_MAX_TABS=15
