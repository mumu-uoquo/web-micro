server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html/main-app;
    index index.html;

    # Sub_App reverse proxy — must come before the catch-all location /
    location ^~ /platform/ {
        proxy_pass ${SUB_APP_ORIGIN}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # app-operate 子应用反向代理：路径前缀须与 MICRO_APP_CONFIGS 中的 activeRule/production entry 一致。
    # 缺少该 location 时 /operate/ 会回落到主应用 index.html，导致子应用加载失败。
    location ^~ /operate/ {
        proxy_pass ${OPERATE_APP_ORIGIN}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Main_App static files with history-mode fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static assets — long-lived cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
}
